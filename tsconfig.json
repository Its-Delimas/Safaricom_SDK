{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "types": ["node"],
        "moduleResolution": "node",
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src"],
    "exclude": ["node_modules","dist"]
}